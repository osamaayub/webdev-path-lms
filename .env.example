# Copy to .env.local for local development. Never commit real values.

# --- Database (Neon Postgres) -------------------------------------------------
# On Vercel these are set for you by the Neon integration.
# DATABASE_URL is the pooled URL (used by the app), DATABASE_URL_UNPOOLED the direct one (used by migrations).
# Local development without Neon: use PGlite, a real Postgres in WASM, stored OUTSIDE the project folder
# (inside it, the dev server's file watcher keeps reloading). Example:
#   DATABASE_URL=pglite:///tmp/webdev-path-db
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Auth.js --------------------------------------------------------------------
# Required for sign-in. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# GitHub OAuth app: github.com/settings/developers -> New OAuth App
#   Homepage URL:             https://your-site.vercel.app
#   Authorization callback:   https://your-site.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web)
#   Authorized redirect URI:  https://your-site.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Reviewers who can open /admin and grade projects (comma-separated emails, as used on GitHub/Google)
ADMIN_EMAILS=

# Local only: shows an email-only "Dev sign in" form. Ignored in production builds.
AUTH_DEV_LOGIN=

# --- SEO --------------------------------------------------------------------------
# Optional: canonical site URL for SEO tags and the sitemap (the Vercel URL is used if empty)
NEXT_PUBLIC_SITE_URL=
